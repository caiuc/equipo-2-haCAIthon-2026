# Mapbox (público). El cliente también acepta MAPBOX_TOKEN vía next.config.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# STT opcional (Whisper compatible). Sin clave, se usa Web Speech o frases de demo.
APIFY_STT_PROVIDER=
APIFY_STT_API_KEY=
APIFY_STT_BASE_URL=
APIFY_STT_MODEL=
APIFY_STT_MAX_UPLOAD_BYTES=

# LLM (DeepSeek u otro). Lo conecta el compañero de Whisper; la UI no lo llama aún.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
