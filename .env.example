# Mapbox (público). El cliente también acepta MAPBOX_TOKEN vía next.config.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# Supabase (anon). next.config copia SUPABASE_* a NEXT_PUBLIC_* si faltan.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# STT (Groq Whisper compatible).
APIFY_STT_PROVIDER=groq
APIFY_STT_API_KEY=
APIFY_STT_BASE_URL=https://api.groq.com/openai/v1
APIFY_STT_MODEL=whisper-large-v3-turbo
APIFY_STT_MAX_UPLOAD_BYTES=25000000

# LLM (DeepSeek). Solo servidor, vía POST /api/structure.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
