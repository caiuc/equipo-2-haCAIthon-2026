# Token público de Mapbox (opcional). Sin él, el tablero usa una vista territorial esquemática.
NEXT_PUBLIC_MAPBOX_TOKEN=

# STT opcional (Whisper compatible, p. ej. Groq). Sin clave, se usa Web Speech o frases de demo.
APIFY_STT_PROVIDER=
APIFY_STT_API_KEY=
APIFY_STT_BASE_URL=
APIFY_STT_MODEL=
APIFY_STT_MAX_UPLOAD_BYTES=

